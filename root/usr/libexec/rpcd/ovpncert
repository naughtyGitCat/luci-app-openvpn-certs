#!/bin/sh
# =============================================================================
# ovpncert — rpcd backend for luci-app-openvpn-certs
# Manage an OpenVPN client-certificate PKI via easy-rsa, all under UCI control.
# Methods: status, list, init_pki, issue, revoke, ovpn, get_settings, set_settings
# No user secrets are embedded; everything is read at runtime from UCI + the PKI.
# =============================================================================
. /usr/share/libubox/jshn.sh

CFG="ovpncert"

cfg() { uci -q get "${CFG}.config.$1"; }

# ---- resolved settings (with sane fallbacks) -------------------------------
PKI="$(cfg pki_dir)";        [ -n "$PKI" ] || PKI="/etc/easy-rsa/pki"
INSTANCE="$(cfg ovpn_instance)"; [ -n "$INSTANCE" ] || INSTANCE="myvpn"
SERVER_CN="$(cfg server_cn)"; [ -n "$SERVER_CN" ] || SERVER_CN="server"
OVPN_DIR="/etc/openvpn"

export EASYRSA_PKI="$PKI"
export EASYRSA_BATCH=1
export EASYRSA_NO_PASS=1

err() { json_init; json_add_boolean ok 0; json_add_string error "$1"; json_dump; exit 0; }
ok()  { json_add_boolean ok 1; }

# resolve a client's connection params (remote/port/proto) for the .ovpn
resolve_remote() {
	local r p o
	r="$(cfg remote)"
	[ -n "$r" ] || r="$(uci -q get openvpn.${INSTANCE}.ddns)"
	p="$(cfg port)"; [ -n "$p" ] || p="$(uci -q get openvpn.${INSTANCE}.port)"; [ -n "$p" ] || p=1194
	o="$(cfg proto)"; [ -n "$o" ] || o="$(uci -q get openvpn.${INSTANCE}.proto)"; [ -n "$o" ] || o=udp
	# server proto -> client proto
	o="$(echo "$o" | sed -e 's/-server//; s/server/client/')"
	echo "$r|$p|$o"
}

pki_ready() { [ -f "$PKI/ca.crt" ] && [ -f "$PKI/private/ca.key" ]; }

# parse easy-rsa / openssl index.txt -> emit "cn|status|expiry" lines, skip server CN
list_certs() {
	[ -f "$PKI/index.txt" ] || return 0
	awk -F'\t' -v server="$SERVER_CN" '
	{
		st=$1; ex=$2; subj=$NF
		cn=subj; sub(/.*\/CN=/,"",cn); sub(/\/.*$/,"",cn)
		if (cn=="" || cn==server) next
		s="valid"; if(st=="R")s="revoked"; else if(st=="E")s="expired"
		print cn "|" s "|" ex
	}' "$PKI/index.txt"
}

case "$1" in
list)
	json_init
	json_add_object "status";    json_close_object
	json_add_object "list";      json_close_object
	json_add_object "get_settings"; json_close_object
	json_add_object "set_settings"
		json_add_string "remote" ""; json_add_string "port" ""
		json_add_string "proto" ""; json_add_string "ovpn_instance" ""
	json_close_object
	json_add_object "init_pki"
		json_add_string "ca_cn" ""; json_add_boolean "apply_to_instance" 0
	json_close_object
	json_add_object "issue";     json_add_string "name" ""; json_close_object
	json_add_object "revoke";    json_add_string "name" ""; json_close_object
	json_add_object "ovpn";      json_add_string "name" ""; json_close_object
	json_dump
	;;
call)
	method="$2"
	read -r input
	[ -n "$input" ] && json_load "$input"

	case "$method" in
	status)
		json_init; ok
		json_add_boolean pki_ready "$(pki_ready && echo 1 || echo 0)"
		json_add_string  pki_dir   "$PKI"
		json_add_string  instance  "$INSTANCE"
		json_add_string  server_cn "$SERVER_CN"
		json_add_boolean easyrsa   "$([ -x /usr/bin/easyrsa ] || command -v easyrsa >/dev/null && echo 1 || echo 0)"
		if [ -f "$PKI/ca.crt" ]; then
			json_add_string ca_subject "$(openssl x509 -in "$PKI/ca.crt" -noout -subject 2>/dev/null | sed 's/^subject=//')"
			json_add_string ca_expiry  "$(openssl x509 -in "$PKI/ca.crt" -noout -enddate 2>/dev/null | sed 's/notAfter=//')"
		fi
		json_dump
		;;

	get_settings)
		json_init; ok
		json_add_string remote        "$(cfg remote)"
		json_add_string port          "$(cfg port)"
		json_add_string proto         "$(cfg proto)"
		json_add_string ovpn_instance "$INSTANCE"
		json_add_string server_cn     "$SERVER_CN"
		json_dump
		;;

	set_settings)
		json_get_var v_remote remote
		json_get_var v_port   port
		json_get_var v_proto  proto
		json_get_var v_inst   ovpn_instance
		uci -q set "${CFG}.config.remote=${v_remote}"
		uci -q set "${CFG}.config.port=${v_port}"
		uci -q set "${CFG}.config.proto=${v_proto}"
		[ -n "$v_inst" ] && uci -q set "${CFG}.config.ovpn_instance=${v_inst}"
		uci -q commit "$CFG"
		json_init; ok; json_dump
		;;

	init_pki)
		command -v easyrsa >/dev/null 2>&1 || err "easyrsa not found (install openvpn-easy-rsa)"
		json_get_var v_cn ca_cn
		json_get_var v_apply apply_to_instance
		[ -n "$v_cn" ] || v_cn="OpenVPN-CA"
		# fresh PKI (this WIPES any existing PKI at $PKI)
		rm -rf "$PKI"
		easyrsa init-pki >/tmp/ovpncert.log 2>&1            || err "init-pki failed (see /tmp/ovpncert.log)"
		EASYRSA_REQ_CN="$v_cn" easyrsa build-ca nopass >>/tmp/ovpncert.log 2>&1 || err "build-ca failed"
		# ECDH (dh none) — avoids the very slow gen-dh on weak routers; modern & secure
		easyrsa build-server-full "$SERVER_CN" nopass >>/tmp/ovpncert.log 2>&1 || err "build-server failed"
		easyrsa gen-crl >>/tmp/ovpncert.log 2>&1            || true
		# only touch the live server files when explicitly applying
		if [ "$v_apply" = "1" ] || [ "$v_apply" = "true" ]; then
			mkdir -p "$OVPN_DIR"
			cp "$PKI/ca.crt"                   "$OVPN_DIR/ca.crt"
			cp "$PKI/issued/${SERVER_CN}.crt"  "$OVPN_DIR/server.crt"
			cp "$PKI/private/${SERVER_CN}.key" "$OVPN_DIR/server.key"
			[ -f "$PKI/crl.pem" ] && cp "$PKI/crl.pem" "$OVPN_DIR/crl.pem"
			chmod 600 "$OVPN_DIR/server.key"
			uci -q set "openvpn.${INSTANCE}.ca=${OVPN_DIR}/ca.crt"
			uci -q set "openvpn.${INSTANCE}.cert=${OVPN_DIR}/server.crt"
			uci -q set "openvpn.${INSTANCE}.key=${OVPN_DIR}/server.key"
			uci -q set "openvpn.${INSTANCE}.dh=none"
			uci -q commit openvpn
			/etc/init.d/openvpn restart >/dev/null 2>&1
		fi
		json_init; ok; json_add_boolean applied "$([ "$v_apply" = 1 ] || [ "$v_apply" = true ] && echo 1 || echo 0)"; json_dump
		;;

	issue)
		command -v easyrsa >/dev/null 2>&1 || err "easyrsa not found (install openvpn-easy-rsa)"
		pki_ready || err "PKI not initialized — run Initialize PKI first"
		json_get_var name name
		echo "$name" | grep -qE '^[A-Za-z0-9_.-]+$' || err "invalid name (use A-Z a-z 0-9 . _ -)"
		[ "$name" = "$SERVER_CN" ] && err "name reserved for the server cert"
		[ -f "$PKI/issued/${name}.crt" ] && err "cert '$name' already exists"
		easyrsa build-client-full "$name" nopass >/tmp/ovpncert.log 2>&1 || err "issue failed (see /tmp/ovpncert.log)"
		json_init; ok; json_add_string name "$name"; json_dump
		;;

	revoke)
		command -v easyrsa >/dev/null 2>&1 || err "easyrsa not found"
		pki_ready || err "PKI not initialized"
		json_get_var name name
		[ -f "$PKI/issued/${name}.crt" ] || err "cert '$name' not found"
		[ "$name" = "$SERVER_CN" ] && err "refusing to revoke the server cert"
		easyrsa revoke "$name" >/tmp/ovpncert.log 2>&1 || err "revoke failed (see /tmp/ovpncert.log)"
		easyrsa gen-crl >>/tmp/ovpncert.log 2>&1 || true
		# stage CRL + enforce on the instance only if it exists, then reload
		if [ -n "$(uci -q get openvpn.${INSTANCE})" ]; then
			[ -f "$PKI/crl.pem" ] && cp "$PKI/crl.pem" "$OVPN_DIR/crl.pem"
			uci -q set "openvpn.${INSTANCE}.crl_verify=${OVPN_DIR}/crl.pem"
			uci -q commit openvpn
			/etc/init.d/openvpn restart >/dev/null 2>&1
		fi
		json_init; ok; json_add_string name "$name"; json_dump
		;;

	list)
		json_init; ok
		json_add_array certs
		# redirect from a temp file (NOT a pipe) so the jshn state isn't lost in a subshell
		_tmp="/tmp/.ovpncert_list.$$"
		list_certs > "$_tmp"
		while IFS='|' read -r cn st ex; do
			[ -n "$cn" ] || continue
			json_add_object ""
			json_add_string  name   "$cn"
			json_add_string  status "$st"
			json_add_string  expiry "$ex"
			json_close_object
		done < "$_tmp"
		rm -f "$_tmp"
		json_close_array
		json_dump
		;;

	ovpn)
		pki_ready || err "PKI not initialized"
		json_get_var name name
		[ -f "$PKI/issued/${name}.crt" ] || err "cert '$name' not found"
		rp="$(resolve_remote)"; remote="${rp%%|*}"; rest="${rp#*|}"; port="${rest%%|*}"; proto="${rest##*|}"
		[ -n "$remote" ] || remote="CHANGE_ME.example.com"
		out="client
dev tun
proto ${proto}
remote ${remote} ${port}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verb 3
<ca>
$(cat "$PKI/ca.crt")
</ca>
<cert>
$(openssl x509 -in "$PKI/issued/${name}.crt" 2>/dev/null)
</cert>
<key>
$(cat "$PKI/private/${name}.key")
</key>"
		# include tls-crypt/tls-auth key if the server uses one
		ta="$(uci -q get openvpn.${INSTANCE}.tls_crypt)"; tatag="tls-crypt"
		[ -n "$ta" ] || { ta="$(uci -q get openvpn.${INSTANCE}.tls_auth)"; tatag="tls-auth"; }
		if [ -n "$ta" ] && [ -f "$ta" ]; then
			out="${out}
<${tatag}>
$(cat "$ta")
</${tatag}>"
			[ "$tatag" = "tls-auth" ] && out="${out}
key-direction 1"
		fi
		json_init; ok; json_add_string name "$name"; json_add_string config "$out"; json_dump
		;;

	*)
		err "unknown method: $method"
		;;
	esac
	;;
esac
